# Copia para .env. Usa UMA connection string em DATABASE_URL.

# Desenvolvimento local (Postgres na máquina)
DATABASE_URL="postgresql://user:password@localhost:5432/votly?schema=public"

# --- Supabase (comenta a linha acima e descomenta uma destas) ---
# 1) Executa prisma/supabase-prisma-user.sql no SQL Editor do Supabase.
# 2) Dashboard → Connect → URI do pooler em modo Session (porta 5432), não Transaction (6543).
# 3) Utilizador na URI: prisma (ex.: prisma.[PROJECT-REF] conforme o dashboard).
# DATABASE_URL="postgresql://prisma.xxxxx:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require"

# SSL para Postgres (Supabase): por defeito a API usa verify relaxado em hosts *.supabase.*
# (evita "self-signed certificate in certificate chain" com proxy/antivírus).
# Produção com cadeia válida: DATABASE_SSL_REJECT_UNAUTHORIZED=true

JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"
JWT_EXPIRES_IN="7d"
PORT=3000
