# Em desenvolvimento com `pnpm dev:web`, o Vite faz proxy de /api → http://localhost:3000
# (não precisa definir VITE_API_URL).
# Com sessão guardada, a app React não redireciona sozinha para :3000 em DEV — continuas em :5173.
#
# Build de produção ou preview sem proxy: URL absoluta da API, sem barra no fim.
# VITE_API_URL=http://localhost:3000
#
# Onde o Nest serve login.html / groups.html (só necessário se a API não for :3000 no mesmo host).
# VITE_API_STATIC_ORIGIN=http://localhost:3000
#
# --- Supabase (opcional, cliente no browser: src/lib/supabase.ts) ---
# Podes usar VITE_* ou os nomes do dashboard / wizard Next (NEXT_PUBLIC_*).
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=...
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=...
